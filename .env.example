# Homologação local (docker-compose.yml). Copie para .env e preencha. Nunca versione o .env.

# Portas publicadas no Windows (via WSL2)
HTTP_PORT=8080
DB_PORT=5433

# PostgreSQL do container de homologação
POSTGRES_DB=ambrosia_homolog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_homolog_db_password_here

# Auth (Auth__JwtSecret: mínimo 32 bytes)
AUTH_JWT_SECRET=your_homolog_jwt_secret_with_at_least_32_chars
AUTH_GOOGLE_CLIENT_ID=

# Proteção de CPF (EncryptionKey: base64 de exatamente 32 bytes — openssl rand -base64 32)
CPF_PEPPER=your_homolog_cpf_pepper_here
CPF_ENCRYPTION_KEY=base64_of_exactly_32_random_bytes
