# Homologação local (docker-compose.yml). Copie para .env e preencha. Nunca versione o .env.

# Portas publicadas no Windows (via WSL2)
HTTP_PORT=8080
DB_PORT=5433

# PostgreSQL do container de homologação
POSTGRES_DB=ambrosio_homolog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_homolog_db_password_here

# Auth (Auth__JwtSecret: mínimo 32 bytes)
AUTH_JWT_SECRET=your_homolog_jwt_secret_with_at_least_32_chars
AUTH_GOOGLE_CLIENT_ID=

# Proteção de CPF (EncryptionKey: base64 de exatamente 32 bytes — openssl rand -base64 32)
CPF_PEPPER=your_homolog_cpf_pepper_here
CPF_ENCRYPTION_KEY=base64_of_exactly_32_random_bytes

# Storage de imagens (feature 004): DigitalOcean Spaces real em homolog e Development — não há
# servidor S3 em container aqui (as imagens do MinIO saíram do Docker Hub; ver decisions.md, seção
# "tasks · imagem do storage"). O endpoint e a região ficam no appsettings; só o par de chaves é
# segredo. A chave precisa poder criar/ler/apagar objetos no bucket e definir a regra CORS dele.
OBJECT_STORAGE_ACCESS_KEY=your_spaces_access_key
OBJECT_STORAGE_SECRET_KEY=your_spaces_secret_key
# Bucket único dos ambientes locais; as imagens ficam na pasta "ambrosio/" dentro dele (nome de bucket no Spaces é global entre contas — se "emagine"
# já estiver tomado, escolha outro e ajuste appsettings.Development.json/appsettings.Homolog.json).
OBJECT_STORAGE_BUCKET=emagine

# Origem pública do bucket, que entra na CSP do frontend (img-src/connect-src). Com
# ForcePathStyle=false o Spaces serve virtual-host: https://<bucket>.<região>.digitaloceanspaces.com
OBJECT_STORAGE_PUBLIC_ORIGIN=https://emagine.nyc3.digitaloceanspaces.com

# Prazos curtos de homolog (minutos), para os testes de expiração e de limpeza rodarem em minutos.
# Padrões do compose: leitura 1, envio 1, pendente 2, limpeza 1. Para simular os prazos de produção
# (15/5/60/15), descomente e ajuste.
#STORAGE_PRESIGNED_READ_MINUTES=1
#STORAGE_PRESIGNED_UPLOAD_MINUTES=1
#STORAGE_PENDING_TTL_MINUTES=2
#STORAGE_CLEANUP_INTERVAL_MINUTES=1

# Importação do +Vendas (feature 006, research §3): qual coletor a API registra. Homologação importa
# de verdade com Playwright. Para a suíte de testes de API (constituição §VIII), troque para Fake — o
# coletor determinístico, sem rede, guiado por login/senha de teste. NUNCA é segredo e NUNCA vai valor
# real de login/senha do +Vendas em arquivo versionado — as credenciais existem só em memória durante
# a execução, informadas pela vendedora na tela (FR-005).
MAIS_VENDAS_COLLECTOR=Playwright

# Plugin do ChatGPT (feature 007, R8/R13): authorization server OAuth 2.1 em /auth e servidor MCP
# em /mcp, no mesmo host (`ambrosio-homolog-mcp`). Os dois endereços são os endereços canônicos do
# serviço e entram por configuração — nunca fixos no código — e o startup recusa qualquer um deles
# com barra no final. Em homologação apontam para o gateway; em produção são
# https://ambrosiaai.site/auth e https://ambrosiaai.site/mcp.
AUTH_ISSUER=http://localhost:8080/auth
MCP_RESOURCE_URL=http://localhost:8080/mcp
# Chave RSA 2048 em PEM (PKCS#8), obrigatória em Homolog e Production — sem ela o host recusa o
# startup (constituição §VI, emenda 3.4.0). Gerar uma vez e guardar como segredo; se ela mudar,
# toda conexão do ChatGPT cai e precisa reconectar.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out mcp-signing.pem
# No .env a chave vai em linha única com \n nos lugares das quebras de linha reais.
# O *.pem em si nunca é versionado (.gitignore já cobre *.pem e *.key).
#AUTH_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# URI de callback que a suite de testes de API registra por DCR; entra como Auth__AllowedRedirectUris__2.
#MCP_TEST_REDIRECT_URI=https://chatgpt.com/connector/oauth/apitest
# Origem de navegador aceita no /mcp (R17) e base do link que a tool iniciar_importacao devolve (R9).
#MCP_ALLOWED_ORIGIN=http://localhost:8080
#MCP_FRONTEND_BASE_URL=http://localhost:8080
