meta {
  name: Anexar Foto
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/customers/{{customerId}}/photos
  body: json
  auth: inherit
}

vars:pre-request {
  customerId: 32
  imageId: 5731
}

body:json {
  {
    "imageId": {{imageId}},
    "description": "provando o vestido azul, ficou ótimo",
    "source": "web"
  }
}

docs {
  Anexa ao álbum uma imagem **já gravada** pelo `POST /images` da 004 (research R7). Não recebe
  arquivo: `multipart` aqui não existe.

  - `201` com `created: true` quando a foto entra;
  - `200` com `created: false` e a foto existente quando a mesma imagem já estava no álbum desta
    cliente (FR-006) — a `description` da foto anterior **não** é sobrescrita;
  - `alsoInOtherCustomers: true` avisa que a mesma imagem está no álbum de outra cliente;
  - `404` se `imageId` não existe ou é de outra vendedora; `400` se está `pending`/`failed`;
  - `source` só aceita `web` ou `api` — `chatGpt` é recusado (a conversa tem a tool própria).
}

tests {
  test("201 novo ou 200 repetido", function () {
    expect([200, 201]).to.include(res.status);
    expect(res.body.photo.photoId).to.be.a('number');
    expect(res.body.photo.imageId).to.equal(Number(bru.getVar("imageId")));
  });

  test("foto nova não é favorita nem perfil", function () {
    if (res.body.created) {
      expect(res.body.photo.isFavorite).to.equal(false);
      expect(res.body.photo.isProfile).to.equal(false);
      expect(res.body.photo.url).to.be.a('string');
    }
  });

  test("Location aponta para a foto criada", function () {
    if (res.status === 201) {
      expect(res.headers.location).to.include(`/photos/${res.body.photo.photoId}`);
    }
  });
}
