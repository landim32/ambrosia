meta {
  name: Create Customer
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/customers
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Cliente Homologação",
    "cpf": "{{newCpf}}"
  }
}

script:pre-request {
  // CPF válido e aleatório a cada execução (o CPF é único por usuário).
  const digits = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));
  const check = (base) => {
    const sum = base.reduce((acc, d, i) => acc + d * (base.length + 1 - i), 0);
    const rest = (sum * 10) % 11;
    return rest === 10 ? 0 : rest;
  };
  digits.push(check(digits));
  digits.push(check(digits));
  bru.setVar("newCpf", digits.join(""));
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("customerId", res.body.id);
  }
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}
