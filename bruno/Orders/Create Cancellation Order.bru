meta {
  name: Create Cancellation Order
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: inherit
}

body:json {
  {
    "customerId": {{customerId}},
    "orderNumber": "{{orderNumber}}",
    "orderDate": "2026-10-25",
    "kind": "cancellation",
    "channel": "Linx",
    "origin": "cota",
    "status": "Cancelado",
    "total": -589.80,
    "originalSaleOn": "2026-10-24",
    "cancelledOn": "2026-10-25",
    "items": [
      { "productName": "Calça Inez", "skuRef": "42CA500UIE_12182", "size": "38", "price": -399.90 },
      { "productName": "Blusa Lia", "skuRef": "41BL200AAA_00001", "size": "P", "price": -189.90 }
    ]
  }
}

tests {
  test("status 201", function () {
    expect(res.status).to.equal(201);
  });
}

docs {
  Cancelamento da venda anterior: total negativo, mesmo número com outro tipo.
}
