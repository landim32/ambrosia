meta {
  name: Credenciais - Remover
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/imports/mais-vendas/credentials
  body: none
  auth: inherit
}

docs {
  Remove as credenciais guardadas (feature 008, FR-006): zera as cinco colunas do cadastro e
  o `status` volta a `none`. O vínculo da conta (`account_hash`) e o bloqueio por recusas não
  mudam — quem foi bloqueado por recusas continua bloqueado, agora sem credenciais salvas.

  Idempotente por contrato: sem nada cadastrado a resposta é `200` com `hasPassword: false`,
  nunca `404`. Depois daqui o próximo `POST …/runs` é recusado até um novo `PUT`.
}

tests {
  test("status 200 com cadastro vazio", function () {
    expect(res.status).to.equal(200);
    expect(res.body.hasPassword).to.equal(false);
    expect(res.body.status).to.equal("none");
    expect(res.body.login).to.equal("");
  });
}
