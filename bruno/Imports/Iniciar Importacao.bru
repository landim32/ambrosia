meta {
  name: Iniciar Importacao
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/imports/mais-vendas/runs
  body: json
  auth: inherit
}

docs {
  Inicia uma execução (FR-001). Login e senha valem só para esta execução e não são
  gravados em lugar nenhum: a resposta 202 não os contém (FR-006). Em homologação
  (coletor Fake) o período 2026-09-26..2026-10-25 com `s482+ok`/`v1` importa 49
  pedidos somando R$ 123.300,58.

  400 = período ou credenciais inválidos; 409 = já existe execução ativa; 429 =
  bloqueio por recusas (cabeçalho `Retry-After` em segundos).
}

body:json {
  {
    "login": "{{maisVendasLogin}}",
    "password": "{{maisVendasPassword}}",
    "startDate": "2026-09-26",
    "endDate": "2026-10-25",
    "dryRun": false
  }
}

script:post-response {
  if (res.status === 202) {
    bru.setEnvVar("importRunId", res.body.id);
  }
}

tests {
  test("status 202 com execução na fila", function () {
    expect(res.status).to.equal(202);
    expect(res.body.status).to.equal("queued");
  });

  test("a resposta não contém credencial", function () {
    const body = JSON.stringify(res.body);
    expect(body).to.not.include(bru.getEnvVar("maisVendasLogin"));
    expect(body.toLowerCase()).to.not.include("password");
  });
}
