meta {
  name: Dev Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/dev-login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{devEmail}}",
    "name": "{{devName}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("token", res.body.token);
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
}

docs {
  Somente em Development e Homolog (404 em Production). Grava o JWT em `token`.
}
