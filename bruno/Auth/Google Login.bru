meta {
  name: Google Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/google
  body: json
  auth: none
}

body:json {
  {
    "idToken": "{{googleIdToken}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("token", res.body.token);
  }
}

docs {
  Troca um ID token do Google por um JWT do Ambrosia. Preencha `googleIdToken` no
  ambiente (exige `AUTH_GOOGLE_CLIENT_ID` configurado na API).

  Reutilizando uma conta que tinha senha, a senha é REMOVIDA neste login (FR-009):
  depois disso só o Google entra, até uma futura troca/recuperação de senha.
}
