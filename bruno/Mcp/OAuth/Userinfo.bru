meta {
  name: Userinfo
  type: http
  seq: 10
}

get {
  url: {{mcpBaseUrl}}/auth/connect/userinfo
  body: none
  auth: bearer
}

auth:bearer {
  token: {{mcpToken}}
}

tests {
  test("200 com e-mail verificado", function () {
    expect(res.status).to.equal(200);
    expect(res.body.email_verified).to.equal(true);
  });
}
