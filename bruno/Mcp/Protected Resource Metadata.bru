meta {
  name: Protected Resource Metadata
  type: http
  seq: 1
}

get {
  url: {{mcpBaseUrl}}/.well-known/oauth-protected-resource/mcp
  body: none
  auth: none
}

tests {
  test("status 200 e recurso do MCP", function () {
    expect(res.status).to.equal(200);
    expect(res.body.resource).to.equal(bru.getEnvVar("mcpBaseUrl") + "/mcp");
  });
}

docs {
  Descoberta do recurso protegido (RFC 9728), anônima: o ChatGPT começa por aqui.
}
