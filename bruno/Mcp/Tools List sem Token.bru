meta {
  name: Tools List sem Token
  type: http
  seq: 3
}

post {
  url: {{mcpBaseUrl}}/mcp
  body: json
  auth: none
}

headers {
  Accept: application/json, text/event-stream
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/list"
  }
}

tests {
  test("sem token: 401 com o desafio que inicia o OAuth", function () {
    expect(res.status).to.equal(401);
    expect(res.headers["www-authenticate"]).to.contain("resource_metadata=");
    expect(res.headers["www-authenticate"]).to.contain("scope=");
  });
}

docs {
  Sem token o /mcp responde 401 com `WWW-Authenticate: Bearer resource_metadata="…", scope="…"` (R23):
  é o desafio que faz o ChatGPT descobrir o authorization server e abrir o login.
}
