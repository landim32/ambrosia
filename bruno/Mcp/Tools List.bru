meta {
  name: Tools List
  type: http
  seq: 3
}

post {
  url: {{mcpBaseUrl}}/mcp
  body: json
  auth: none
}

headers {
  Accept: application/json, text/event-stream
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/list"
  }
}

tests {
  test("sem token: 401 com o desafio que inicia o OAuth", function () {
    expect(res.status).to.equal(401);
    expect(res.headers["www-authenticate"]).to.contain("resource_metadata=");
  });
}

docs {
  Sem token o /mcp responde 401 com WWW-Authenticate (resource_metadata e scope): é o desafio que faz o ChatGPT abrir o login (R23). Com token, a resposta vem em SSE (event: message / data: {...}).
}
