meta {
  name: Auditoria (Homolog)
  type: http
  seq: 8
}

get {
  url: {{mcpBaseUrl}}/mcp/diagnostics/audit?tool=cadastrar_cliente
  body: none
  auth: bearer
}

auth:bearer {
  token: {{mcpToken}}
}

tests {
  test("200 com as entradas do próprio usuário", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}

docs {
  Trilha de auditoria das gravações do próprio usuário (CPF mascarado). Só existe em Development e
  Homolog; em produção responde 404.
}
