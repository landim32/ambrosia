meta {
  name: Iniciar Importacao
  type: http
  seq: 7
}

post {
  url: {{mcpBaseUrl}}/mcp
  body: json
  auth: bearer
}

auth:bearer {
  token: {{mcpToken}}
}

headers {
  Accept: application/json, text/event-stream
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
      "name": "iniciar_importacao",
      "arguments": { "inicio": "2026-09-26", "fim": "2026-10-25", "confirmar": true }
    }
  }
}

tests {
  // Resposta do /mcp em SSE ("event: message" / "data: {...}"): o JSON-RPC é o último "data:".
  function rpc(body) {
    const text = typeof body === "string" ? body : JSON.stringify(body);
    const lines = text.split("\n").filter(l => l.startsWith("data:"));
    return JSON.parse(lines.length ? lines[lines.length - 1].slice(5).trim() : text);
  }

  test("200 sem erro de tool", function () {
    expect(res.status).to.equal(200);
    const result = rpc(res.body).result;
    expect(result.isError || false).to.equal(false);
    expect(result.structuredContent.gravado).to.equal(true);
    expect(result.structuredContent.registro.importacao_id).to.be.a('number');
  });
}

docs {
  Desde a feature 008 esta tool INICIA a importação: com `confirmar: true` ela chama o mesmo
  `IImportRunService` da tela, com `startedVia: mcp`, e devolve `importacao_id` — que aparece
  em `GET /imports/mais-vendas/runs/current` na próxima leitura da tela. O host do MCP não
  coleta nada (a imagem não tem Chromium): a fila é o banco, e o worker da API pega a linha.

  Sem credenciais cadastradas a resposta é `isError` com o link da tela de configuração
  (`/configuracoes/mais-vendas`) — não há campo de login nem senha aqui, e nunca houve: a
  senha não passa pela conversa (FR-018).

  Rode antes `Credenciais - Salvar` no Bruno (ou pela tela) para cadastrar as credenciais
  Fake do cenário. Com `confirmar: false` a chamada só devolve a prévia do período.
}
