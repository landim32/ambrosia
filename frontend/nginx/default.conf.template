# Config do container do frontend (HU 002, T088; template desde a 004, T053).
#
# O gateway de borda (deploy/nginx/routes.inc) ja decide o que e /api, /auth,
# /mcp e /.well-known: nada disso chega aqui. Este server so serve o SPA.
#
# CSP restritiva porque o JWT mora em localStorage: um XSS no bundle seria o
# caminho direto para o token (docs/historias/002 §8). As unicas excecoes sao as
# origens do Google Identity Services (script, conect e estilo do botao) e, desde
# a 004, o endpoint publico do storage de imagens (FR-023).
#
# Este arquivo e um TEMPLATE do nginx oficial: no startup do container o envsubst
# gera /etc/nginx/conf.d/default.conf a partir dele, substituindo apenas
# ${STORAGE_ORIGIN} (o NGINX_ENVSUBST_FILTER no Dockerfile protege as variaveis do
# proprio nginx, como $uri, de serem substituidas). Assim a CSP aponta para o
# storage de cada ambiente sem rebuild: MinIO nao existe mais aqui, e o valor vem
# do STORAGE_ORIGIN fixo no docker-compose.yml (research §15).
#
# Atencao: `add_header` nao herda quando o bloco de location declara o seu — os
# tres cabecalhos de seguranca se repetem em cada location de proposito.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # --- Cabecalhos de seguranca (research §18) -----------------------------
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; connect-src 'self' https://accounts.google.com/gsi/ ${STORAGE_ORIGIN}; frame-src https://accounts.google.com/gsi/; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: https: ${STORAGE_ORIGIN}" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;

    # --- Assets com hash no nome: cache de um ano, imutavel -----------------
    location /assets/ {
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; connect-src 'self' https://accounts.google.com/gsi/ ${STORAGE_ORIGIN}; frame-src https://accounts.google.com/gsi/; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: https: ${STORAGE_ORIGIN}" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, immutable" always;

        expires 1y;
        try_files $uri =404;
    }

    # --- index.html NUNCA em cache -----------------------------------------
    # O bundle muda a cada deploy: se o index ficasse no navegador, a vendedora
    # carregaria chunks que ja nao existem (404 de asset na abertura).
    location = /index.html {
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; connect-src 'self' https://accounts.google.com/gsi/ ${STORAGE_ORIGIN}; frame-src https://accounts.google.com/gsi/; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: https: ${STORAGE_ORIGIN}" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;

        try_files $uri =404;
    }

    # --- Fallback do SPA ---------------------------------------------------
    # Toda rota interna (/clientes, /clientes/12, /pedidos?tipo=sale) e um
    # endereco digitavel e compartilhavel (FR-015): devolve o shell e o Router
    # decide a tela.
    location / {
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; connect-src 'self' https://accounts.google.com/gsi/ ${STORAGE_ORIGIN}; frame-src https://accounts.google.com/gsi/; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: https: ${STORAGE_ORIGIN}" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;

        try_files $uri $uri/ /index.html;
    }

    # Compressao: o texto dos chunks e o CSS sao o ganho do orcamento de bundle.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}
