# URL base da API (relativa à origem em todos os ambientes; em dev o Vite faz
# proxy de /api -> http://localhost:5000). Constituição §"Variáveis de Ambiente".
VITE_API_URL=/api

# Base path do React Router. Vazio: o app fica na raiz da origem.
VITE_SITE_BASENAME=

# Client ID OAuth do Google (GIS). Deve ser o mesmo valor de Auth__GoogleClientId
# da API. Vazio esconde o botão "Entrar com Google".
VITE_GOOGLE_CLIENT_ID=

# "true" mostra o formulário de entrada de desenvolvimento. AUSENTE em produção
# (FR-002 / SC-008: o componente sai do bundle).
VITE_DEV_LOGIN=
