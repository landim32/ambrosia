# Produção (docker-compose-prod.yml). Gerado no servidor pelo pipeline a partir dos GitHub Secrets
# de mesmo nome. Somente segredos; o restante fica em appsettings.Production.json.

# DigitalOcean Managed PostgreSQL (porta 25060, SSL obrigatório)
AMBROSIO_CONNECTION_STRING=Host=<cluster>.db.ondigitalocean.com;Port=25060;Database=ambrosia;Username=<user>;Password=<STRONG_PASSWORD>;SSL Mode=Require

# Auth
AMBROSIO_JWT_SECRET=<STRONG_JWT_SECRET_MIN_64_CHARS>
AMBROSIO_GOOGLE_CLIENT_ID=<GOOGLE_OAUTH_CLIENT_ID>

# Proteção de CPF — a chave NUNCA pode mudar depois do primeiro cadastro (CPFs ficam ilegíveis)
AMBROSIO_CPF_PEPPER=<STRONG_RANDOM_PEPPER>
AMBROSIO_CPF_ENCRYPTION_KEY=<BASE64_OF_EXACTLY_32_RANDOM_BYTES>

# Storage de imagens (feature 004, Spaces). Só o par de chaves é segredo; o bucket (`ambrosia-prod`)
# e a origem pública dele (CSP do frontend) são fixos no docker-compose-prod.yml, e endpoint, região
# e ForcePathStyle ficam no appsettings.Production.json. A chave precisa poder criar/ler/apagar
# objetos no bucket, bloquear acesso público e definir a regra CORS dele.
S3_ACCESS_KEY=<SPACES_ACCESS_KEY>
S3_SECRET_KEY=<SPACES_SECRET_KEY>

# Plugin do ChatGPT (feature 007, R8/R13): authorization server OAuth 2.1 em /auth + servidor MCP
# em /mcp, no host `ambrosia-mcp`. Os endereços canônicos (https://ambrosiaai.site/auth e /mcp), a
# origem aceita no /mcp e a base do link do iniciar_importacao são fixos no docker-compose-prod.yml.
# Chave RSA 2048 que assina os access tokens do AS (PKCS#8, PEM). GitHub Secret de mesmo nome,
# gravado aqui pelo deploy-prod.yml. OBRIGATÓRIA: o host recusa o startup sem ela em Production
# (constituição §VI, emenda 3.4.0).
# Gerar uma vez:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out mcp-signing.pem
# O segredo precisa ser gravado EM LINHA ÚNICA com \n no lugar das quebras reais — o heredoc do
# pipeline escreve KEY=valor, e um PEM multilinha quebraria o .env.prod. Mudar esta chave derruba
# todas as conexões do ChatGPT (os tokens emitidos deixam de validar no JWKS) e exige reconexão.
AMBROSIO_AUTH_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
