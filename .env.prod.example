# Produção (docker-compose-prod.yml). Gerado no servidor pelo pipeline a partir dos GitHub Secrets
# de mesmo nome. Somente segredos; o restante fica em appsettings.Production.json.

# DigitalOcean Managed PostgreSQL (porta 25060, SSL obrigatório)
DB_CONNECTION_STRING=Host=<cluster>.db.ondigitalocean.com;Port=25060;Database=ambrosia;Username=<user>;Password=<STRONG_PASSWORD>;SSL Mode=Require

# Auth
AUTH_JWT_SECRET=<STRONG_JWT_SECRET_MIN_64_CHARS>
AUTH_GOOGLE_CLIENT_ID=<GOOGLE_OAUTH_CLIENT_ID>

# Proteção de CPF — a chave NUNCA pode mudar depois do primeiro cadastro (CPFs ficam ilegíveis)
CPF_PEPPER=<STRONG_RANDOM_PEPPER>
CPF_ENCRYPTION_KEY=<BASE64_OF_EXACTLY_32_RANDOM_BYTES>

# Storage de imagens (feature 004, Spaces). Só o par de chaves é segredo; endpoint, região,
# bucket e ForcePathStyle ficam no appsettings.Production.json. A chave precisa poder
# criar/ler/apagar objetos no bucket, bloquear acesso público e definir a regra CORS dele.
OBJECT_STORAGE_ACCESS_KEY=<SPACES_ACCESS_KEY>
OBJECT_STORAGE_SECRET_KEY=<SPACES_SECRET_KEY>
# Origem pública do bucket, que o container do frontend coloca na CSP (img-src/connect-src).
# Com ForcePathStyle=false o Spaces serve virtual-host: https://<bucket>.<região>.digitaloceanspaces.com
OBJECT_STORAGE_PUBLIC_ORIGIN=https://ambrosia-prod.nyc3.digitaloceanspaces.com
