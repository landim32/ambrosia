# Produção (docker-compose-prod.yml). Gerado no servidor pelo pipeline a partir dos GitHub Secrets
# de mesmo nome. Somente segredos; o restante fica em appsettings.Production.json.

# DigitalOcean Managed PostgreSQL (porta 25060, SSL obrigatório)
DB_CONNECTION_STRING=Host=<cluster>.db.ondigitalocean.com;Port=25060;Database=ambrosia;Username=<user>;Password=<STRONG_PASSWORD>;SSL Mode=Require

# Auth
AUTH_JWT_SECRET=<STRONG_JWT_SECRET_MIN_64_CHARS>
AUTH_GOOGLE_CLIENT_ID=<GOOGLE_OAUTH_CLIENT_ID>

# Proteção de CPF — a chave NUNCA pode mudar depois do primeiro cadastro (CPFs ficam ilegíveis)
CPF_PEPPER=<STRONG_RANDOM_PEPPER>
CPF_ENCRYPTION_KEY=<BASE64_OF_EXACTLY_32_RANDOM_BYTES>

# Storage de imagens (feature 004, Spaces). Só o par de chaves é segredo; endpoint, região,
# bucket e ForcePathStyle ficam no appsettings.Production.json. A chave precisa poder
# criar/ler/apagar objetos no bucket, bloquear acesso público e definir a regra CORS dele.
OBJECT_STORAGE_ACCESS_KEY=<SPACES_ACCESS_KEY>
OBJECT_STORAGE_SECRET_KEY=<SPACES_SECRET_KEY>
# Origem pública do bucket, que o container do frontend coloca na CSP (img-src/connect-src).
# Com ForcePathStyle=false o Spaces serve virtual-host: https://<bucket>.<região>.digitaloceanspaces.com
OBJECT_STORAGE_PUBLIC_ORIGIN=https://ambrosia-prod.nyc3.digitaloceanspaces.com

# Importação do +Vendas (feature 006, research §3): obrigatoriamente Playwright em produção — o
# startup RECUSA Collector=Fake com ASPNETCORE_ENVIRONMENT=Production, porque o fake não coleta nada
# e uma importação "bem-sucedida" inventada corromperia a base da vendedora. Não há segredo aqui:
# login e senha do +Vendas só existem em memória durante a execução, informados pela vendedora na
# tela (FR-005/FR-006).
MAIS_VENDAS_COLLECTOR=Playwright

# Plugin do ChatGPT (feature 007, R8/R13): authorization server OAuth 2.1 em /auth + servidor MCP
# em /mcp, no host `ambrosia-mcp`. Os dois endereços abaixo são os canônicos e imutáveis do serviço
# (spec 007, "Endereços definitivos", decididos em 25/10/2026) — o mesmo valor já está no
# appsettings.Production.json, então estas linhas são opcionais: servem para conferir/fixar por
# env. O startup recusa qualquer um dos dois com barra no final ou em http fora de Development.
AUTH_ISSUER=https://ambrosiaai.site/auth
MCP_RESOURCE_URL=https://ambrosiaai.site/mcp
# Chave RSA 2048 que assina os access tokens do AS (PKCS#8, PEM). GitHub Secret de mesmo nome,
# gravado aqui pelo deploy-prod.yml. OBRIGATÓRIA: o host recusa o startup sem ela em Production
# (constituição §VI, emenda 3.4.0).
# Gerar uma vez:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out mcp-signing.pem
# O segredo precisa ser gravado EM LINHA ÚNICA com \n no lugar das quebras reais — o heredoc do
# pipeline escreve KEY=valor, e um PEM multilinha quebraria o .env.prod. Mudar esta chave derruba
# todas as conexões do ChatGPT (os tokens emitidos deixam de validar no JWKS) e exige reconexão.
AUTH_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Origem de navegador aceita no /mcp (R17) e base do link que a tool iniciar_importacao devolve
# para a vendedora digitar a senha do +Vendas na tela (R9).
MCP_ALLOWED_ORIGIN=https://ambrosiaai.site
MCP_FRONTEND_BASE_URL=https://ambrosiaai.site
