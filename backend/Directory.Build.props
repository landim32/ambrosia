<Project>

  <!--
    Licença Six Labors (ImageSharp 3.2.0+).

    A partir do 3.2.0 o pacote traz um alvo de MSBuild (SixLabors.ImageSharp.targets) que exige
    licença no BUILD: em Debug é aviso, em Release o build para. Por isso o docker build e o deploy
    em produção não compilam sem a chave.

    O Ambrosia é MIT/open source, que é a faixa gratuita da Six Labors Split License v1.0 — basta
    pedir a chave em https://sixlabors.com/pricing/ e gravar o arquivo como `backend/sixlabors.lic`.
    Ele é lido aqui a partir da raiz desta pasta, então nenhum csproj precisa mudar.

    Em CI, em vez de versionar o arquivo, passe a chave por propriedade:
      dotnet build -p:SixLaborsLicenseKey="$(SIXLABORS_LICENSE_KEY)"
    (a chave também pode vir de segredo do GitHub Actions; é por assembly, então o nome do projeto
    compilado precisa bater com o que a licença cobre).

    Sem o arquivo nada quebra o Debug: o build continua e avisa. Ver
    specs/004-s3-image-storage/decisions.md (seção "tasks · licença ImageSharp").
  -->
  <PropertyGroup Condition="'$(SixLaborsLicenseFile)' == '' And '$(SixLaborsLicenseKey)' == '' And Exists('$(MSBuildThisFileDirectory)sixlabors.lic')">
    <SixLaborsLicenseFile>$(MSBuildThisFileDirectory)sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>

</Project>
