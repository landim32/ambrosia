<Project Sdk="Microsoft.NET.Sdk">

  <!-- Application: composition root (Startup/DI) e agregador de settings. -->
  <!-- Versões de Microsoft.Extensions.* alinhadas ao transitivo do EF Core 9 (NU1605). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.12.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.22" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.22" />
    <!-- BackgroundService do job de limpeza de envios abandonados (research §9), registrado no
         composition root. Mesma linha 9.0.22 do resto do grafo Microsoft.Extensions.*. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ambrosia.Domain\Ambrosia.Domain.csproj" />
    <ProjectReference Include="..\Ambrosia.Infra\Ambrosia.Infra.csproj" />
    <ProjectReference Include="..\Ambrosia.Infra.Interfaces\Ambrosia.Infra.Interfaces.csproj" />
    <ProjectReference Include="..\Ambrosia.DTO\Ambrosia.DTO.csproj" />
  </ItemGroup>

</Project>
