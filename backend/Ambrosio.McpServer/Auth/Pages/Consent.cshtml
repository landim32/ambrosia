@page "/consent"
@model ConsentModel
@using Ambrosio.McpServer.Auth.Endpoints
@{
    ViewData["Title"] = "Autorizar o ChatGPT";
}

@if (Model.IsExpansion)
{
    <h1>Ampliar o acesso do @Model.ClientName</h1>
    <p class="lead">O @Model.ClientName já tem parte do acesso e agora pede também o que está sem a marca "já autorizado".</p>
}
else
{
    <h1>Autorizar o @Model.ClientName</h1>
    <p class="lead">O @Model.ClientName quer acessar sua conta do Ambrosio para:</p>
}

@foreach (var area in Model.AreaGroups)
{
    <h2 class="area">@area.Title</h2>
    <ul class="scopes">
        @foreach (var scope in area.Scopes)
        {
            <li class="@(scope.AlreadyGranted ? "granted" : "new")" data-scope="@scope.Name">
                <strong>@scope.DisplayName</strong>
                @if (scope.AlreadyGranted)
                {
                    <em class="badge">já autorizado</em>
                }
                <span>@scope.Description</span>
            </li>
        }
    </ul>
}

<form method="post" action="@Model.AuthorizeAction">
    @Html.AntiForgeryToken()
    @foreach (var parameter in Model.Parameters)
    {
        <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
    }
    <div class="actions">
        <button type="submit" class="btn-secondary" name="@AuthorizationEndpoint.DecisionField"
                value="@AuthorizationEndpoint.DecisionDeny">Negar</button>
        <button type="submit" class="btn-primary" name="@AuthorizationEndpoint.DecisionField"
                value="@AuthorizationEndpoint.DecisionAccept">Autorizar</button>
    </div>
</form>
