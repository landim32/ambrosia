<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testes HTTP ponta a ponta (skill dotnet-test-api): referencia SOMENTE o projeto DTO. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="Flurl.Http" Version="4.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.22" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.22" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.22" />
    <!-- Necessário para T089: gerar JWT assinado por OUTRA chave e provar o 401. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.Test.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Fixtures binários da feature 004 (T028): os testes de API fazem SHA-256 e conferem bytes,
         então os arquivos têm de chegar à pasta de saída intactos. -->
    <Content Include="Fixtures\Images\small.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\Images\small.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\Images\small.webp" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\Images\other.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ambrosio.DTO\Ambrosio.DTO.csproj" />
  </ItemGroup>

</Project>
