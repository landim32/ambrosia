<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infra: DbContext, repositórios e AppServices (Npgsql, JWT, Google OAuth, proteção de CPF). -->
  <!-- Microsoft.Extensions.* e EF Core alinhados em 9.0.22: Npgsql 9.0.4 traz Relational 9.0.1
       como mínimo, e a referência explícita abaixo unifica o grafo (evita MSB3277/NU1605). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.22" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.22" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.22">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Google.Apis.Auth" Version="1.77.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.22" />
    <!-- Storage de imagens (feature 004): cliente S3 de referência (troca de provedor só por
         configuração — research §1) e detector/processador de imagem gerenciado, sem binário
         nativo no container Linux (research §7). Ficam restritos à Infra. O ImageSharp é 3.2.0 e
         não a última 3.1.x do research: as seis advisories conhecidas da série 3.1 (quatro altas,
         entre elas CVE-2026-106118, escrita fora do heap no decodificador) só são corrigidas em
         3.2.0 — e este pacote decodifica imagem enviada por usuário. Ver decisions.md. -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.7" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ambrosia.Domain\Ambrosia.Domain.csproj" />
    <ProjectReference Include="..\Ambrosia.Infra.Interfaces\Ambrosia.Infra.Interfaces.csproj" />
    <ProjectReference Include="..\Ambrosia.DTO\Ambrosia.DTO.csproj" />
  </ItemGroup>

</Project>
