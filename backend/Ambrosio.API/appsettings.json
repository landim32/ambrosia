{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AmbrosioContext": ""
  },
  "Auth": {
    "JwtSecret": "",
    "Issuer": "ambrosio",
    "Audience": "ambrosio",
    "ExpirationMinutes": 129600,
    "GoogleClientId": ""
  },
  "CpfProtection": {
    "Pepper": "",
    "EncryptionKey": ""
  },
  "ObjectStorage": {
    "ServiceUrl": "",
    "PublicServiceUrl": "",
    "Region": "us-east-1",
    "Bucket": "",
    "ForcePathStyle": false,
    "AccessKey": "",
    "SecretKey": "",
    "PresignedReadMinutes": 15,
    "PresignedUploadMinutes": 5,
    "MaxUploadBytes": 10485760,
    "AllowedMimeTypes": [ "image/jpeg", "image/png", "image/webp" ],
    "PendingTtlMinutes": 60,
    "CleanupIntervalMinutes": 15
  },
  "MaisVendas": {
    "Collector": "Playwright",
    "BaseUrl": "https://maisvendas.somalabs.com.br",
    "BlockDays": 7,
    "MaxRangeMonths": 3,
    "CredentialsKey": "",
    "MaxConcurrentRuns": 2,
    "MaxFailedLogins": 3,
    "LockoutMinutes": 15,
    "MinDelayMs": 300,
    "MaxDelayMs": 900,
    "Fake": {
      "DelayMs": 50
    }
  }
}
